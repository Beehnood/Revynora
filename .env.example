DATABASE_URL=postgresql://revynora:local_dev_only@localhost:5433/revynora?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:3000
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=10
AI_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=2
COOKIE_SECURE=false
SESSION_DAYS=7
# Optionnel : tarifs configurés par million de tokens, sinon estimation null.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=

# Phase 2 — test/local only. Never use Stripe live credentials.
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
REDIS_URL=redis://127.0.0.1:6380
WORKER_ENABLED=true
QUEUE_NAME=revynora-reminders
MAIL_PROVIDER=local
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Five strictly increasing Leitner intervals in days; restart API after changes.
LEITNER_INTERVAL_DAYS=1,2,4,8,16

# Phase 2.5 — independently configurable applications, no deployment.
API_URL=http://127.0.0.1:3001
ADMIN_ORIGIN=http://localhost:3002
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
