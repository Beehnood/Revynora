generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  STUDENT
  ADMIN
}
enum Plan {
  FREE
  PLUS
  PRO
}
enum CourseSource {
  USER
  AI
  ADMIN
}
enum QuestionType {
  SINGLE
  MULTIPLE
}
enum UsageStatus {
  PENDING
  SUCCESS
  ERROR
}
model FoundationCheck {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(STUDENT)
  plan Plan @default(FREE)
  createdAt DateTime @default(now())
  sessions Session[]
  courses Course[]
  quizzes Quiz[]
  attempts QuizAttempt[]
  aiUsage AIUsage[]
  timeZone String @default("Europe/Paris")
  remindersEnabled Boolean @default(false)
  reminderConsentAt DateTime?
  termsAcceptedAt DateTime?
  disabledAt DateTime?
  stripeCustomerId String? @unique
  commercialPermission CommercialPermission?
  subscriptionPeriods UserSubscriptionHistory[]
  payments Payment[]
  paymentEvents UserPaymentHistory[]
  checkoutIntents CheckoutIntent[]
  leitnerCards LeitnerCard[]
  revisions Revision[]
  studyPlans StudyPlan[]
  availability StudyAvailability[]
  emails EmailMessage[]
  auditActions AuditLog[] @relation("AuditActor")
  grants InternalLearningGrant[] @relation("LearningBeneficiary")
  issuedGrants InternalLearningGrant[] @relation("LearningIssuer")
  revokedGrants InternalLearningGrant[] @relation("LearningRevoker")
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model Course {
  id String @id @default(uuid())
  ownerId String?
  owner User? @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  title String
  domain String
  content String
  source CourseSource @default(USER)
  createdAt DateTime @default(now())
  quizzes Quiz[]
  cards LeitnerCard[]
  revisions Revision[]
  planItems StudyPlanItem[]
  @@index([ownerId, createdAt])
}
model Quiz {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  courseId String
  course Course @relation(fields:[courseId], references:[id], onDelete:Restrict)
  domain String
  topic String
  level String
  provider String
  createdAt DateTime @default(now())
  questions Question[]
  attempts QuizAttempt[]
  @@index([ownerId, createdAt])
}
model Question {
  id String @id @default(uuid())
  quizId String
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
  position Int
  text String
  concept String
  explanation String
  type QuestionType
  options QuestionOption[]
  answers Answer[]
  @@unique([quizId, position])
}
model QuestionOption {
  id String @id @default(uuid())
  questionId String
  question Question @relation(fields:[questionId],references:[id],onDelete:Cascade)
  position Int
  text String
  correct Boolean
  @@unique([questionId, position])
}
model QuizAttempt {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  quizId String
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
  startedAt DateTime @default(now())
  submittedAt DateTime?
  score Int?
  answers Answer[]
  @@index([userId, startedAt])
}
model Answer {
  id String @id @default(uuid())
  attemptId String
  attempt QuizAttempt @relation(fields:[attemptId],references:[id],onDelete:Cascade)
  questionId String
  question Question @relation(fields:[questionId],references:[id],onDelete:Cascade)
  selectedOptionIds String[]
  updatedAt DateTime @updatedAt
  @@unique([attemptId, questionId])
}
model AIUsage {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  provider String
  model String?
  status UsageStatus @default(PENDING)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCostUsd Decimal? @db.Decimal(12, 8)
  attempts Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum TaskStatus {
  PLANNED
  DONE
  CANCELLED
}
enum MailStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}
model Subscription {
  id String @id @default(uuid())
  code Plan @unique
  name String
  priceCents Int
  currency String @default("eur")
  interval String @default("month")
  active Boolean @default(true)
  providerPriceId String? @unique
  revision Int @default(0)
  currentVersionId String? @unique
  currentVersion CommercialOfferVersion? @relation("CurrentOfferVersion",fields:[currentVersionId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  versions CommercialOfferVersion[] @relation("OfferVersions")
  periods UserSubscriptionHistory[]
}
model UserSubscriptionHistory {
  providerPriceId String?
  commercialVersionId String?
  commercialVersion CommercialOfferVersion? @relation(fields:[commercialVersionId],references:[id],onDelete:Restrict)
  contractEvidence String @default("LEGACY_UNVERIFIED")
  features String[] @default([])
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  subscriptionId String
  subscription Subscription @relation(fields:[subscriptionId],references:[id],onDelete:Restrict)
  provider String
  providerSubscriptionId String
  priceCents Int
  currency String
  status SubscriptionStatus
  startsAt DateTime
  endsAt DateTime
  cancelAtPeriodEnd Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([providerSubscriptionId, startsAt, subscriptionId])
  @@index([userId, startsAt, endsAt])
}
model CheckoutIntent {
  commercialVersionId String?
  commercialVersion CommercialOfferVersion? @relation(fields:[commercialVersionId],references:[id],onDelete:Restrict)
  acceptedPriceCents Int?
  acceptedCurrency String?
  acceptedInterval String?
  acceptedFeatures String[] @default([])
  acceptedProviderPriceId String?
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  plan Plan
  provider String
  providerSessionId String? @unique
  url String?
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model BillingState {
  providerSubscriptionId String @id
  customerId String
  lastEventCreated BigInt @default(0)
  updatedAt DateTime @updatedAt
}
model Payment {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  providerReference String @unique
  provider String
  amountCents Int
  currency String
  status PaymentStatus
  receiptUrl String?
  periodId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events UserPaymentHistory[]
  @@index([userId, createdAt])
}
model UserPaymentHistory {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  paymentId String?
  payment Payment? @relation(fields:[paymentId],references:[id],onDelete:SetNull)
  providerEventId String @unique
  eventType String
  amountCents Int?
  status String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model LeitnerCard {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  courseId String?
  course Course? @relation(fields:[courseId],references:[id],onDelete:SetNull)
  front String
  back String
  box Int @default(1)
  dueAt DateTime @default(now())
  version Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  revisions Revision[]
  @@index([userId, dueAt])
}
model Revision {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  cardId String
  card LeitnerCard @relation(fields:[cardId],references:[id],onDelete:Cascade)
  courseId String?
  course Course? @relation(fields:[courseId],references:[id],onDelete:SetNull)
  requestId String @unique
  durationSeconds Int?
  remembered Boolean
  fromBox Int
  toBox Int
  nextDueAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model StudyPlan {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  timeZone String
  createdAt DateTime @default(now())
  generationKey String? @unique
  generationHash String?
  items StudyPlanItem[]
  @@index([userId, createdAt])
}
model StudyPlanItem {
  id String @id @default(uuid())
  planId String
  plan StudyPlan @relation(fields:[planId],references:[id],onDelete:Cascade)
  title String
  courseId String?
  course Course? @relation(fields:[courseId],references:[id],onDelete:SetNull)
  kind String @default("REVISION")
  priority Int @default(2)
  startsAt DateTime
  endsAt DateTime
  status TaskStatus @default(PLANNED)
  reminderMinutes Int?
  version Int @default(0)
  createdAt DateTime @default(now())
  versions StudyPlanItemVersion[]
  @@index([startsAt])
  @@index([planId, startsAt])
}
model EmailMessage {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  subject String
  body String
  provider String @default("local")
  status MailStatus @default(QUEUED)
  idempotencyKey String @unique
  attempts Int @default(0)
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation("AuditActor",fields:[actorId],references:[id],onDelete:SetNull)
  targetUserId String?
  action String
  entityType String
  entityId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model MockBillingRecord {
 id String @id
 snapshot Json
 updatedAt DateTime @updatedAt
}
model ReminderDelivery {
 id String @id @default(uuid())
 itemId String
 version Int
 dueAt DateTime
 status String @default("PENDING")
 @@unique([itemId, version])
}

model StudyPlanItemVersion {
 id String @id @default(uuid())
 itemId String
 item StudyPlanItem @relation(fields:[itemId],references:[id],onDelete:Cascade)
 version Int
 title String
 startsAt DateTime
 endsAt DateTime
 status TaskStatus
 reminderMinutes Int?
 courseId String?
 kind String @default("REVISION")
 priority Int @default(2)
 recordedAt DateTime @default(now())
 @@unique([itemId,version])
}

model StudyAvailability {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 startsAt DateTime
 endsAt DateTime
 @@index([userId, startsAt])
}

// Internal access is independent of commercial subscriptions and payments.
model InternalLearningGrant {
  id String @id @default(uuid())
  userId String
  user User @relation("LearningBeneficiary", fields:[userId], references:[id], onDelete:Restrict)
  level Plan @default(PRO)
  startsAt DateTime
  expiresAt DateTime?
  provenance String
  justification String
  createdAt DateTime @default(now())
  issuedById String
  issuedBy User @relation("LearningIssuer", fields:[issuedById], references:[id], onDelete:Restrict)
  revokedAt DateTime?
  revokedById String?
  revokedBy User? @relation("LearningRevoker", fields:[revokedById], references:[id], onDelete:Restrict)
  revocationReason String?
  @@index([userId, revokedAt, startsAt])
}

// Explicit commercial capability. No automatic grant, including to ADMIN accounts.
model CommercialPermission {
 userId String @id
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 grantedAt DateTime @default(now())
 provenance String
}
model CommercialOfferVersion {
 id String @id @default(uuid())
 subscriptionId String
 subscription Subscription @relation("OfferVersions",fields:[subscriptionId],references:[id],onDelete:Restrict)
 currentFor Subscription? @relation("CurrentOfferVersion")
 number Int
 basedOnRevision Int
 name String
 priceCents Int
 currency String
 interval String
 active Boolean
 features String[]
 reason String
 createdById String?
 createdAt DateTime @default(now())
 state String @default("DRAFT")
 bindings CommercialProviderPrice[]
 periods UserSubscriptionHistory[]
 checkouts CheckoutIntent[]
 @@unique([subscriptionId,number])
}
model CommercialProviderPrice {
 id String @id @default(uuid())
 versionId String
 version CommercialOfferVersion @relation(fields:[versionId],references:[id],onDelete:Restrict)
 provider String
 environment String
 accountId String
 priceId String
 verifiedAt DateTime @default(now())
 verifiedById String
 @@unique([provider,environment,accountId,priceId])
 @@unique([versionId,provider])
}
model CommercialAudit {
 id String @id @default(uuid())
 actorId String
 action String
 subscriptionId String
 versionId String
 beforeVersionId String?
 reason String
 createdAt DateTime @default(now())
}
