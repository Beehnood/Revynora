generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  STUDENT
  ADMIN
}
enum Plan {
  FREE
}
enum CourseSource {
  USER
  AI
  ADMIN
}
enum QuestionType {
  SINGLE
  MULTIPLE
}
enum UsageStatus {
  PENDING
  SUCCESS
  ERROR
}
model FoundationCheck {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(STUDENT)
  plan Plan @default(FREE)
  createdAt DateTime @default(now())
  sessions Session[]
  courses Course[]
  quizzes Quiz[]
  attempts QuizAttempt[]
  aiUsage AIUsage[]
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model Course {
  id String @id @default(uuid())
  ownerId String?
  owner User? @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  title String
  domain String
  content String
  source CourseSource @default(USER)
  createdAt DateTime @default(now())
  quizzes Quiz[]
  @@index([ownerId, createdAt])
}
model Quiz {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  courseId String
  course Course @relation(fields:[courseId], references:[id], onDelete:Restrict)
  domain String
  topic String
  level String
  provider String
  createdAt DateTime @default(now())
  questions Question[]
  attempts QuizAttempt[]
  @@index([ownerId, createdAt])
}
model Question {
  id String @id @default(uuid())
  quizId String
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
  position Int
  text String
  concept String
  explanation String
  type QuestionType
  options QuestionOption[]
  answers Answer[]
  @@unique([quizId, position])
}
model QuestionOption {
  id String @id @default(uuid())
  questionId String
  question Question @relation(fields:[questionId],references:[id],onDelete:Cascade)
  position Int
  text String
  correct Boolean
  @@unique([questionId, position])
}
model QuizAttempt {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  quizId String
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
  startedAt DateTime @default(now())
  submittedAt DateTime?
  score Int?
  answers Answer[]
  @@index([userId, startedAt])
}
model Answer {
  id String @id @default(uuid())
  attemptId String
  attempt QuizAttempt @relation(fields:[attemptId],references:[id],onDelete:Cascade)
  questionId String
  question Question @relation(fields:[questionId],references:[id],onDelete:Cascade)
  selectedOptionIds String[]
  updatedAt DateTime @updatedAt
  @@unique([attemptId, questionId])
}
model AIUsage {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  provider String
  model String?
  status UsageStatus @default(PENDING)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCostUsd Decimal? @db.Decimal(12, 8)
  attempts Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
