# Build from the repository root. No .env or credentials enter the build context.
FROM node:22.18.0-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
# Keep the prepared pnpm readable by the non-root, network-isolated migration stage.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate && pnpm build:api
RUN pnpm --filter @revynora/api deploy --legacy --prod /runtime
RUN node -e 'const fs=require("fs"),path=require("path");const p=require.resolve(".prisma/client/package.json",{paths:[require.resolve("@prisma/client/package.json")]});fs.mkdirSync("/runtime/node_modules/.prisma",{recursive:true});fs.cpSync(path.dirname(p),"/runtime/node_modules/.prisma/client",{recursive:true});'
FROM build AS migration
USER node
CMD ["pnpm", "db:migrate"]
FROM node:22.18.0-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3001
WORKDIR /app/apps/api
COPY --from=build --chown=node:node /runtime ./
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e 'fetch("http://127.0.0.1:3001/api/v1/health/ready").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'
CMD ["node", "dist/main.js"]
