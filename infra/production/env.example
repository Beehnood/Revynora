# Install privately on the server as infra/production/.env.production (0600).
# Hex values avoid URI escaping problems. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
REVYNORA_API_PORT=3101
REVYNORA_IMAGE_TAG=candidate
AI_PROVIDER=mock
AI_DAILY_LIMIT=10
AI_MAX_ATTEMPTS=2
AI_TIMEOUT_MS=20000
OPENAI_MODEL=gpt-4.1-mini
# Set OPENAI_API_KEY privately only when enabling AI_PROVIDER=openai.
BILLING_PROVIDER=mock
# Staging simulation only. Live payments are not supported by the existing phase 2 adapter.
MAIL_PROVIDER=local
WORKER_ENABLED=true
LEITNER_INTERVAL_DAYS=1,3,7,14,30
SESSION_DAYS=7

# Proposed upper limits; review capacity of the shared VM before deployment.
API_MEMORY_LIMIT=768m
POSTGRES_MEMORY_LIMIT=1024m
REDIS_MEMORY_LIMIT=256m
