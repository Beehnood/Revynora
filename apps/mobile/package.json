{
  "name": "@revynora/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts src"
  },
  "dependencies": {
    "expo": "57.0.30",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@revynora/types": "workspace:*",
    "@revynora/validation": "workspace:*",
    "@revynora/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "@types/node": "22.18.12",
    "typescript": "6.0.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.2"
  }
}
