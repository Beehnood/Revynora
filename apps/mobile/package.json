{
  "name": "@revynora/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts src",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "check:release": "node scripts/check-release.cjs",
    "eas-build-pre-install": "node scripts/check-release.cjs"
  },
  "dependencies": {
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@revynora/api-client": "workspace:*",
    "@revynora/types": "workspace:*",
    "@revynora/validation": "workspace:*",
    "expo": "57.0.30",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.12",
    "@types/react": "19.2.4",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "9.39.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
