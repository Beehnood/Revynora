{
  "name": "@revynora/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "db:check": "tsx src/database/check.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "@prisma/client": "6.19.0",
    "@revynora/types": "workspace:*",
    "@revynora/validation": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "dotenv": "17.2.3",
    "@nestjs/swagger": "11.2.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.8",
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.2",
    "@types/express": "5.0.5"
  }
}
