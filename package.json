{
  "name": "revynora",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "pnpm test:prepare && turbo test:coverage",
    "test:e2e": "pnpm test:prepare && pnpm --filter @revynora/web test:e2e",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "pnpm --filter @revynora/api db:check",
    "db:seed": "node prisma/seed.cjs",
    "test:integration": "pnpm test:prepare && pnpm --filter @revynora/api test:integration",
    "test:prepare": "node scripts/prepare-test-db.cjs"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
